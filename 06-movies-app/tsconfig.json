{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ],
      // @react-native/virtualized-lists 0.86.3 importa sus propios tipos por una ruta que su package.json bloquea
      "@react-native/virtualized-lists/Lists/*": [
        "./node_modules/@react-native/virtualized-lists/Lists/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ]
}